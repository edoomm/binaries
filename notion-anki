#!/bin/bash

# Exit immediately if a command exits with a non-zero status
set -e

# 1. Check if a file argument was provided
if [ -z "$1" ]; then
    echo "Error: Please provide the path to the main zip file."
    echo "Usage: $0 /path/to/file.zip"
    exit 1
fi

MAIN_ZIP="$1"

# Verify the file actually exists
if [ ! -f "$MAIN_ZIP" ]; then
    echo "Error: File '$MAIN_ZIP' not found."
    exit 1
fi

# Create a temporary working directory to keep things organized
WORK_DIR="notion_anki_temp"
mkdir -p "$WORK_DIR"

# Extract the main zip into our working directory
unzip -q "$MAIN_ZIP" -d "$WORK_DIR"

# 2. Look for the nested zip file inside the working directory
NESTED_ZIP=$(find "$WORK_DIR" -name "*.zip" -print -quit)

if [ -n "$NESTED_ZIP" ]; then
    unzip -q "$NESTED_ZIP" -d "$WORK_DIR"
fi

# 'find' will locate all CSV files, even inside subfolders
find "$WORK_DIR" -type f -name "*.csv" | while read -r csv_file; do
    # 'tail' skips the first line (+2 starts at line 2) and saves it back
    tail -n +2 "$csv_file" > "$csv_file.tmp" && mv "$csv_file.tmp" "$csv_file"
done

echo "Extraction complete. Your CSV files are ready in: ./$WORK_DIR"

# 3. Pause and wait for user interaction
echo "Please import the CSV files into Anki."
read -p "Press [ENTER] once imported to finish the process and clean up..."

# 4. Cleanup everything
rm -rf "$WORK_DIR"
rm -f "$MAIN_ZIP"

echo "Done!"
